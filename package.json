{
  "name": "visual-stream-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/clean-sites-build.mjs && vite build && node scripts/prepare-sites-build.mjs",
    "fetch:pages-media": "node scripts/fetch-pages-media.mjs",
    "prepare:publish-media": "bash scripts/prepare-publish-media.sh",
    "update:media-manifest": "node scripts/update-pages-media-manifest.mjs",
    "evaluate:media-crf": "node scripts/evaluate-publish-crf.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "verify:media": "node scripts/verify-media.mjs",
    "verify:playback": "node scripts/verify-playback.mjs && node scripts/verify-player-state.mjs",
    "verify:ui": "node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide": "^1.23.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "^0.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "vite": "^8.1.3"
  }
}
